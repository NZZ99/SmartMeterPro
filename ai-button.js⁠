(function() {
    function setupAI() {
        const btn = document.getElementById('ai-floating-btn');
        const box = document.getElementById('ai-response-box');
        const closeBtn = document.getElementById('ai-close-btn');

        if (!btn || !box || !closeBtn) {
            setTimeout(setupAI, 500);
            return;
        }

        closeBtn.onclick = function(e) {
            e.stopPropagation();
            box.classList.add('hidden');
        };

        let isDragging = false;
        let startX, startY, initialX, initialY;

        btn.onpointerdown = function(e) {
            isDragging = false;
            startX = e.clientX;
            startY = e.clientY;
            
            const rect = btn.getBoundingClientRect();
            initialX = rect.left;
            initialY = rect.top;
            
            btn.setPointerCapture(e.pointerId);
            
            btn.onpointermove = function(ev) {
                const dx = ev.clientX - startX;
                const dy = ev.clientY - startY;
                
                if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                    isDragging = true;
                }
                
                btn.style.left = `${initialX + dx}px`;
                btn.style.top = `${initialY + dy}px`;
                btn.style.right = 'auto';
                btn.style.bottom = 'auto';
                btn.style.transform = 'none';
            };
            
            btn.onpointerup = function() {
                btn.onpointermove = null;
                btn.onpointerup = null;
                
                if (!isDragging) {
                    triggerAI(box);
                }
            };
        };
    }

    async function triggerAI(box) {
        box.classList.remove('hidden');
        const outputDiv = document.getElementById('ai-output-content');
        outputDiv.innerText = "လက်ရှိ Page အား AI က လေ့လာနေပါသည်...";

        const pageContent = document.body.innerText || "";

        try {
            const response = await fetch('/api/gemini', {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ context: pageContent })
            });
            
            const data = await response.json();
            
            if (data.error) {
                outputDiv.innerText = "Error: " + data.error;
                alert("Vercel Backend Error: " + data.error); // ⚠️ ဘာအမှားလဲသိရအောင် Alert ထည့်ထားသည်
            } else {
                outputDiv.innerText = data.reply;
            }
        } catch (error) {
            console.error("Error:", error);
            outputDiv.innerText = "ချိတ်ဆက်မှု မအောင်မြင်ပါ။ Vercel Dashboard တွင် GEMINI_API_KEY ထည့်ထားလား ပြန်စစ်ပေးပါ။";
            alert("Fetch Error: အနောက်ကွယ်က /api/gemini.js ဖိုင်ကို လှမ်းခေါ်လို့မရပါ။");
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupAI);
    } else {
        setupAI();
    }
})();
